{
  "_": "Nice design tokens: the one source. scripts/build.mjs turns this into the cards' CSS variables (src/core/tokens.js reads it) and into themes/nice.yaml (Nice, Nice Day, Nice Night). Change a value here, nowhere else.",
  "font": {
    "display": "\"Bricolage Grotesque\", \"Avenir Next\", system-ui, sans-serif",
    "body": "\"Figtree\", system-ui, -apple-system, sans-serif",
    "url": "https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=Figtree:wght@500;600;700;800&display=swap"
  },
  "space": { "2xs": 2, "xs": 4, "sm": 8, "md": 12, "lg": 16, "xl": 24 },
  "radius": { "xs": 4, "sm": 8, "md": 12, "tile": 24, "full": 999 },
  "control": { "xs": 16, "sm": 24, "md": 32, "lg": 44 },
  "row": 132,
  "type": {
    "label": { "size": "0.76em", "weight": 800, "track": "0.08em", "opacity": 0.72 },
    "say": { "size": "1.45em", "line": 1.1, "big": "3em", "bigLine": 1 },
    "sub": { "size": "0.9em", "weight": 600, "opacity": 0.78 },
    "title": { "size": "1.35em", "weight": 800 },
    "pill": { "size": "0.86em", "weight": 800 }
  },
  "motion": { "quick": ".2s", "tile": ".25s", "bar": ".4s", "fill": "3s", "holdMs": 520, "confirmMs": 4000 },
  "focus": "#5ab8ff",
  "status": {
    "ok":     ["#2fc98a", "#4fe0a0"],
    "busy":   ["#5ab8ff", "#7cc6ff"],
    "warn":   ["#ff8a3d", "#ff9a52"],
    "alert":  ["#f04a42", "#ff5d5d"],
    "locked": ["#8b7cf6", "#a78bfa"],
    "muted":  ["#9aa3b8", "#b4bccd"]
  },
  "families": {
    "_": "[OKLCH hue, chroma, optional lightness offset for soft and strong]. Hue says what a tile is about; weight (below) says how much it matters. hazard and act are kept for danger and do-this-now: no topic wears them.",
    "hazard":   [27, 0.21],
    "act":      [50, 0.17],
    "chores":   [85, 0.15],
    "power":    [128, 0.16],
    "car":      [152, 0.15],
    "ambience": [185, 0.11],
    "climate":  [215, 0.12],
    "water":    [242, 0.17],
    "plans":    [295, 0.17],
    "cats":     [350, 0.16],
    "system":   [255, 0.025, -0.04]
  },
  "alwaysSolid": ["hazard"],
  "weights": {
    "_": "[fill lightness, chroma scale, accent lightness, accent chroma scale] per weight. soft: most tiles. strong: tier 1, soon. solid: tier 0, now (light ink; darkened until it reads).",
    "day":   { "soft": [0.95, 0.4, 0.6, 0.95], "strong": [0.91, 0.7, 0.56, 1], "solid": [0.6, 1, 0, 0] },
    "night": { "soft": [0.34, 0.35, 0.8, 0.8], "strong": [0.44, 0.6, 0.85, 0.75], "solid": [0.6, 0.95, 0, 0] }
  },
  "ink": { "dark": "#1c2233", "light": "#ffffff", "nightLight": "#f4f5fa" },
  "minContrast": 4.5,
  "aliases": {
    "_": "Old tone names, still accepted from rules and card configs.",
    "today": "chores", "plan": "plans", "media": "ambience", "energy": "power", "scenes": "ambience", "money": "power",
    "night": "ambience", "timer": "act", "festive": "ambience", "health": "system", "recycling": "water", "trash": "car",
    "muted": "system", "litter": "cats"
  },
  "off": { "day": ["#eceef3", "#6b7388", "#8b93a7"], "night": ["#2b3244", "#b4bccd", "#b4bccd"] },
  "room": { "_": "A lit room, [OKLCH lightness, chroma, hue]: one warm neutral for every room.", "day": [0.975, 0.014, 75], "night": [0.38, 0.022, 70] },
  "cats": ["cats", "climate", "chores", "water"],
  "chrome": {
    "day":   { "bg": "#eef0f5", "ink": "#6b7388", "inkStrong": "#1c2233", "selBg": "#1c2233", "selInk": "#ffffff", "pill": "rgba(28,34,51,.08)" },
    "night": { "bg": "#2b3244", "ink": "#b4bccd", "inkStrong": "#ffffff", "selBg": "#e1e5ef", "selInk": "#141a2c", "pill": "rgba(255,255,255,.16)" }
  },
  "theme": {
    "_": "What the rest of Home Assistant wears (themes/nice.yaml). Corners follow radius above.",
    "primary": ["#2b0b05", "#47140a", "#6e1f10", "#a32e17", "#d9431f", "#ff6b4a", "#ff8669", "#ffa38c", "#ffc4b4", "#ffe2d9", "#fff0eb"],
    "neutral": ["#0b0e16", "#11151f", "#1a1f2c", "#2b3244", "#3d4559", "#5a6276", "#7a8194", "#9aa1b2", "#c3c8d4", "#e3e6ee", "#f2f3f7"],
    "accent": { "day": "#6a4be0", "night": "#a78bfa" },
    "page": { "day": "#f6f7fa", "night": "#0e1119" },
    "card": { "day": "#ffffff", "night": "#161a24" },
    "text": { "day": ["#1c2233", "#6b7388", "#a7adbb"], "night": ["#eef0f6", "#9aa1b2", "#5a6276"] }
  }
}
