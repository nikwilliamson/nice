{#- Nice - timers on the Google speakers and displays (the Google Home integration, polled
    every 3 minutes, its default). One tile per timer, tier 1 (act now). While it runs, the tile is just
    the time left, ticking in the browser (say '{left}' with ends), and never pushes. Once it
    goes off ("ringing" is worked out from the fire time too, so the tile doesn't wait for a
    poll) it's Time's up! with a Stop button, and pushes if it's still ringing after four
    minutes: longer than a poll, so a timer stopped at the speaker never pushes. -#}

{#- "0:10:00" or "1 day, 0:10:00" in seconds -#}
{%- macro secs(d) -%}
{%- set p = (d | string).split(', ')[-1].split(':') -%}
{{ (p[0] | int(0)) * 3600 + (p[1] | int(0)) * 60 + (p[2] | float(0)) | int if p | count == 3 else 0 }}
{%- endmacro -%}

{%- macro tiles() -%}
{%- set ns = namespace(t=[], all=[]) -%}
{%- set ts = as_timestamp(now()) -%}
{%- for e in integration_entities('google_home') | select('search', '_timers$') -%}
  {%- for tm in state_attr(e, 'timers') or [] -%}
    {%- set fire = tm.fire_time | float(0) -%}
    {%- set ringing = tm.status == 'ringing' or (tm.status == 'set' and fire and fire <= ts) -%}
    {%- set ns.all = ns.all + [dict(entity=e, id=tm.timer_id, label=(tm.label or '') | trim, ringing=ringing, paused=tm.status == 'paused',
        fire=fire, total=secs(tm.duration) | int, room=area_name(e) or '')] -%}
  {%- endfor -%}
{%- endfor -%}
{#- One tile per timer, ringing first, then the next to go off, paused last; so cancelling
    one takes its own tile away -#}
{%- set order = (ns.all | selectattr('ringing') | list) + (ns.all | rejectattr('ringing') | rejectattr('paused') | sort(attribute='fire') | list) + (ns.all | selectattr('paused') | list) -%}
{%- for t in order -%}
  {%- set what = (t.label | capitalize ~ ' timer') if t.label else ((t.total // 60) ~ ' min timer' if t.total >= 60 else 'Timer') -%}
  {%- set id = 'timer-' ~ t.id.split('/')[-1][:8] -%}
  {%- if t.ringing -%}
    {%- set rang = ((ts - t.fire) / 60) if t.fire else 0 -%}
    {%- set ns.t = ns.t + [dict(id=id, tier=1, order=loop.index, shape='S', label=[t.room, what] | select | join(' · '), tone='hazard',
        say="Time's up!", sub='', viz=none, entity=t.entity, tap=none,
        act=dict(label='Stop', type='service', service='google_home.delete_timer', entity_id=t.entity, data=dict(timer_id=t.id)),
        push=(dict(level='time-sensitive', key=t.id, title=what ~ ' is going off', message="It's been ringing in the " ~ t.room | lower ~ ' for a few minutes.') if rang >= 4 else false))] -%}
  {%- else -%}
    {#- The say is the time left, counting down in the browser ({left}) -#}
    {%- set ns.t = ns.t + [dict(id=id, tier=1, order=loop.index, shape='S', label=[t.room, what] | select | join(' · '), tone='timer', push=false,
        say=('Paused' if t.paused else '{left}'), sub='', big=true,
        ends=((t.fire * 1000) | int if t.fire and not t.paused else none), viz=none, entity=t.entity, tap=none,
        act=dict(label='Cancel', type='service', service='google_home.delete_timer', entity_id=t.entity, data=dict(timer_id=t.id), confirm=true))] -%}
  {%- endif -%}
{%- endfor -%}
{{ ns.t | to_json }}
{%- endmacro -%}
