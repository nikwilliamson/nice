{#- Bento sports - the rules for the sports tiles, kept apart from bento.jinja because
    there are a lot of them. tiles() in bento.jinja imports sports_tiles() and adds what
    it returns. Same tile shape as there; color is the team's own, drawn as the tile, and
    badge is a word pinned top-right ("Live"). The eyebrow is only ever the team or series.

    Season tickets (Lightning, Orlando City):
      48 h out    a standalone question, "Going to Bolts vs Kraken Saturday?", until it's
                  answered. Answers live in input_text.sports_rsvp as event_id:y / :n
      game day    going: the game and when to leave, then "head out" as act-now 30 min
                  before. Lightning leaves 3 h before puck drop, Orlando 1 h before
                  kickoff. "Time to go." only while Nik is home. Once someone is at the
                  arena it just says who.
                  not going, or an away game: "Bolts vs Panthers at 7", nothing else
      live        the score and the latest play; hidden only while you're both at the game.
                  score carries our side's number so the card can pulse on a goal
      final       the result, for 12 h
    Following (Spurs, IndyCar, F1): ambient while live; before and after, only to fill
    a hole.

    Team Tracker states: PRE, IN, POST (also NOT_FOUND, BYE, which show nothing). -#}

{%- from 'bento.jinja' import at_clock -%}

{#- "Bolts up 3–2", "Tied 1–1"; final: "Bolts win 4–2." -#}
{%- macro score_say(e, nick, final) -%}
{%- set ts = state_attr(e, 'team_score') | int(0) -%}{%- set os = state_attr(e, 'opponent_score') | int(0) -%}{%- set opp = state_attr(e, 'opponent_name') -%}
{%- if final -%}
  {%- if ts > os -%}{{ nick }} win {{ ts }}–{{ os }}.{%- elif os > ts -%}{{ opp }} win {{ os }}–{{ ts }}.{%- else -%}{{ nick }} draw {{ ts }}–{{ os }}.{%- endif -%}
{%- else -%}
  {%- if ts > os -%}{{ nick }} up {{ ts }}–{{ os }}{%- elif os > ts -%}{{ opp }} up {{ os }}–{{ ts }}{%- elif ts == 0 -%}Scoreless{%- else -%}Tied {{ ts }}–{{ os }}{%- endif -%}
{%- endif -%}
{%- endmacro -%}

{#- "tonight", "today", "tomorrow night", "Saturday" -#}
{%- macro day_word(start) -%}
{%- set d = (start.date() - now().date()).days -%}
{%- set eve = start.hour >= 17 -%}
{{ ('tonight' if eve else 'today') if d == 0 else ('tomorrow night' if eve else 'tomorrow') if d == 1 else start.strftime('%A') }}
{%- endmacro -%}

{#- "7", "7:30": the time with no am/pm, for "Bolts vs Panthers at 7" -#}
{%- macro short_time(dt) -%}
{{ dt.strftime('%-I') if dt.minute == 0 else dt.strftime('%-I:%M') }}
{%- endmacro -%}

{%- macro sports_tiles(away) -%}
{%- set ns = namespace(t=[]) -%}
{%- set rsvp = states('input_text.sports_rsvp').split(',') | reject('eq', '') | reject('eq', 'unknown') | list -%}
{%- set nik_home = is_state('person.nikw', 'home') -%}

{#- [sensor, nickname, label, hours to leave before the start, arena zone, what the start is called] -#}
{%- for s in [['tampa_bay_lightning', 'Bolts', 'Lightning', 3, 'zone.tampa_bay_lightning', 'puck drop'],
              ['orlando_city', 'Orlando', 'Orlando City', 1, 'zone.orlando_city', 'kickoff']] -%}
  {%- set e = 'sensor.' ~ s[0] -%}
  {%- set st = states(e) -%}
  {%- if st in ['PRE', 'IN', 'POST'] -%}
    {%- set a = (expand(e) | first).attributes -%}
    {%- set start = as_datetime(a.date) | as_local -%}
    {%- set mins = ((start - now()).total_seconds() / 60) | int -%}
    {%- set home_game = a.team_homeaway == 'home' -%}
    {%- set eid = a.event_id | string -%}
    {%- set ans = (rsvp | select('match', eid ~ ':') | first | default('')) -%}
    {%- set there = (state_attr(s[4], 'persons') or []) | map('state_attr', 'friendly_name') | list -%}
    {%- set at_arena = there | count > 0 -%}
    {%- set going = home_game and (ans.endswith(':y') or at_arena) -%}
    {%- set color = (a.team_colors or ['#1c2233'])[0] -%}
    {%- set vs = (' vs ' if home_game else ' at ') ~ a.opponent_name -%}
    {%- set leave = start - timedelta(hours=s[3]) -%}
    {%- set to_leave = ((leave - now()).total_seconds() / 60) | int -%}
    {%- set keep = rsvp | reject('match', eid ~ ':') | list -%}
    {%- set say_yes = (keep[-7:] + [eid ~ ':y']) | join(',') -%}
    {%- set say_no = (keep[-7:] + [eid ~ ':n']) | join(',') -%}

    {%- if st == 'PRE' and home_game and not ans and not at_arena and 0 < mins <= 48 * 60 -%}
      {#- The question: on its own tile, from 48 h out until it's answered. Act now if
          it's still open within an hour of leaving -#}
      {%- set tier = 1 if to_leave <= 60 else 2 if mins <= 24 * 60 else 3 -%}
      {%- set ns.t = ns.t + [dict(id='ask_' ~ s[0], tier=tier, order=(7 if tier == 1 else 2 if tier == 2 else 1), shape='W', label=s[2], tone='plan', color=color,
          say='Going to ' ~ s[1] ~ vs ~ ' ' ~ day_word(start) ~ '?',
          sub=(s[5] | capitalize) ~ ' at ' ~ at_clock(start),
          viz=dict(type='buttons', items=[dict(label='Going', service='input_text.set_value', entity_id='input_text.sports_rsvp', data=dict(value=say_yes), primary=true),
              dict(label='Not this one', service='input_text.set_value', entity_id='input_text.sports_rsvp', data=dict(value=say_no), primary=false)]),
          act=none, tap=none)] -%}

    {%- elif st == 'PRE' and start.date() == now().date() and going -%}
      {%- if at_arena -%}
        {%- set ns.t = ns.t + [dict(id='sport_' ~ s[0], tier=3, order=0, shape='W', label=s[2], tone='plan', color=color,
            say=there | join(' and ') ~ (' is' if there | count == 1 else ' are') ~ ' at the ' ~ s[2] ~ ' game', sub='', viz=none, act=none, tap=none)] -%}
      {%- elif 0 < to_leave <= 30 -%}
        {%- set ns.t = ns.t + [dict(id='sport_' ~ s[0], tier=1, order=7, shape='W', label=s[2], tone='plan', color=color,
            say='Head out in ' ~ to_leave ~ ' min for ' ~ s[5] ~ '.', sub=s[1] ~ vs, viz=none, act=none, tap=none)] -%}
      {%- elif -60 < to_leave <= 0 and nik_home -%}
        {%- set ns.t = ns.t + [dict(id='sport_' ~ s[0], tier=1, order=7, shape='W', label=s[2], tone='plan', color=color,
            say='Time to go.', sub=s[1] ~ vs, viz=none, act=none, tap=none)] -%}
      {%- else -%}
        {%- set ns.t = ns.t + [dict(id='sport_' ~ s[0], tier=2, order=2, shape='W', label=s[2], tone='plan', color=color,
            say=s[1] ~ vs ~ ' ' ~ day_word(start) ~ ', ' ~ at_clock(start) ~ '.',
            sub=('Leave by ' ~ at_clock(leave) if to_leave > 0 else ''), viz=none, act=none, tap=none)] -%}
      {%- endif -%}

    {%- elif st == 'PRE' and start.date() == now().date() and (not home_game or ans.endswith(':n')) -%}
      {#- Watching at home -#}
      {%- set ns.t = ns.t + [dict(id='sport_' ~ s[0], tier=(2 if mins <= 60 else 3), order=2, shape='W', label=s[2], tone='plan', color=color,
          say=s[1] ~ ' vs ' ~ a.opponent_name ~ ' at ' ~ short_time(start), sub='', viz=none, act=none, tap=none)] -%}

    {%- elif st == 'IN' and not (away and at_arena) -%}
      {%- set ns.t = ns.t + [dict(id='sport_' ~ s[0], tier=2, order=0, shape='W', label=s[2], badge='Live', tone='plan', color=color,
          say=score_say(e, s[1], false), sub=(a.last_play or ''), score=a.team_score | int(0), viz=none, act=none, tap=none)] -%}

    {%- elif st == 'POST' and mins > -12 * 60 -%}
      {%- set ns.t = ns.t + [dict(id='sport_' ~ s[0], tier=3, order=1, shape='W', label=s[2], tone='plan', color=color,
          say=score_say(e, s[1], true), sub='', viz=none, act=none, tap=none)] -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

{#- Following: [sensor, nickname, or '' to use the league] -#}
{%- for f in [['tottenham', 'Spurs'], ['indycar', ''], ['f1', '']] -%}
  {%- set e = 'sensor.' ~ f[0] -%}
  {%- set st = states(e) -%}
  {%- if st in ['PRE', 'IN', 'POST'] and not away -%}
    {%- set a = (expand(e) | first).attributes -%}
    {%- set start = as_datetime(a.date) | as_local -%}
    {%- set mins = ((start - now()).total_seconds() / 60) | int -%}
    {%- set racing = a.sport == 'racing' -%}
    {%- set name = f[1] or ('IndyCar' if a.league == 'IRL' else a.league) -%}
    {%- set color = (a.team_colors or [none])[0] if not racing else none -%}
    {%- if st == 'IN' -%}
      {%- set ns.t = ns.t + [dict(id='sport_' ~ f[0], tier=3, order=3, shape='W', label=name, badge='Live', tone='night', color=color,
          say=(a.team_name ~ ' leads' if racing else score_say(e, name, false)), sub=(a.event_name if racing else a.clock), viz=none, act=none, tap=none)] -%}
    {%- elif st == 'PRE' and 0 <= mins <= 180 -%}
      {%- set ns.t = ns.t + [dict(id='sport_' ~ f[0], tier=3, order=98, shape='S', filler=true, label=name, tone='night', color=color,
          say=name ~ ' at ' ~ at_clock(start), sub=(a.event_name if racing else 'vs ' ~ a.opponent_name), viz=none, act=none, tap=none)] -%}
    {%- elif st == 'POST' and mins > -6 * 60 -%}
      {%- set ns.t = ns.t + [dict(id='sport_' ~ f[0], tier=3, order=98, shape='S', filler=true, label=name, tone='night', color=color,
          say=(a.team_name ~ ' wins.' if racing else score_say(e, name, true)), sub=(a.event_name if racing else ''), viz=none, act=none, tap=none)] -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}
{{ ns.t | to_json }}
{%- endmacro -%}
